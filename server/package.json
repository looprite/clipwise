{
  "name": "clipwise-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clipwise API server",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:checks": "tsx src/db/checks.ts",
    "db:sync": "drizzle-kit push && tsx src/db/checks.ts && tsx src/auth/migrate.ts",
    "db:provision": "tsx src/db/provision.ts",
    "db:studio": "drizzle-kit studio",
    "auth": "tsx src/auth/cli.ts",
    "auth:migrate": "tsx src/auth/migrate.ts",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-auth": "1.7.7",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "jose": "6.2.12",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "better-call": {
      "zod": "$zod"
    }
  }
}
