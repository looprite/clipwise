# Postgres connection string. Requires the pgvector extension. The app
# connects over TCP with node-postgres (no serverless driver), so any
# Postgres with pgvector works in principle; Neon is the current hosted
# default and the only one this has actually been verified against,
# so portability to other Postgres providers is unconfirmed. A bundled
# local-Postgres profile is planned but not yet available.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Host port to publish the server on. Container always listens on 3000.
PORT=3000

# Anthropic API key. Required by src/extract/extract.ts, which throws without
# it before doing any work. The capture pipeline is spawned by the recorder
# and inherits no shell, so this has to live here rather than be exported per
# run. Get one at https://console.anthropic.com  →  API Keys.
ANTHROPIC_API_KEY=

# Voyage AI embeddings API key. Required by src/lib/voyage.ts for semantic
# search over moments; without it, semantic queries fail at the API boundary.
# Get one at https://dashboard.voyageai.com  →  API Keys.
VOYAGE_API_KEY=

# Google Calendar OAuth client (SAA-115). Created in the Google Cloud console —
# a console task, not scripted here. OAuth 2.0 Client ID, type "Web
# application", scope https://www.googleapis.com/auth/calendar.readonly,
# redirect URI matching GOOGLE_OAUTH_REDIRECT_URI below exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Symmetric key for encrypting calendar refresh/access tokens at rest
# (src/lib/crypto.ts). Generate with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Sign-in (src/auth). The server mounts it only when BETTER_AUTH_SECRET is set.
# Secret for signing sessions and tokens, at least 32 characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this instance, no trailing slash. http://localhost:3000 for
# local work; the HTTPS origin claude.ai reaches when hosted.
BETTER_AUTH_URL=http://localhost:3000
# The MCP endpoint exactly as the user enters it in Claude. Tokens are bound to
# it. Defaults to BETTER_AUTH_URL + /mcp.
MCP_RESOURCE_URL=
# Password sign-in. Off unless "true". Meant for local work and a personal
# instance; a team instance signs in with Google (next step) and leaves it off.
AUTH_PASSWORD_ENABLED=false
# If set, only emails on this domain may sign in, on top of being a member.
AUTH_ALLOWED_EMAIL_DOMAIN=
# Behind a proxy: the header carrying the real client address (Fly: fly-client-ip).
# Requests without it are refused. Unset for a direct connection, where the
# socket's address is used. Without it behind a proxy, everyone shares one
# sign-in rate-limit bucket.
AUTH_IP_HEADER=
# Access-token lifetime in seconds. Short on purpose; refresh tokens renew it.
AUTH_ACCESS_TOKEN_SECONDS=600

# Whose Mac this is: the member that recordings captured by the pipeline (which
# writes to the database directly, with no token) belong to. Required once the
# account has more than one member; with exactly one it is picked automatically.
# A value that is not an active member fails the ingest step on purpose.
CLIPWISE_OWNER_EMAIL=

# Provisioning a new instance's database (empty database, direct connection):
#   npm run db:provision
#   npm run auth -- init-account --name "Team name"
#   AUTH_PASSWORD=... npm run auth -- bootstrap-admin --email you@example.com --password-env AUTH_PASSWORD
# Bringing an existing database up to date (push asks for confirmation):
#   npm run db:sync
